{
  "name": "framekit",
  "version": "1.3.9",
  "private": true,
  "description": "FrameKit - a cross-platform toolkit for video editors and post-production artists.",
  "main": "out/main/index.js",
  "author": "FrameKit",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "clean:build": "node scripts/clean-build.mjs",
    "build": "npm run clean:build && npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "demo": "tsx scripts/demo-server.ts",
    "test:parser": "tsx scripts/parser-smoke.ts",
    "test:update": "tsx scripts/update-smoke.ts",
    "test:github": "tsx scripts/github-fallback-smoke.ts",
    "test:weibo": "tsx scripts/weibo-smoke.ts",
    "test:cctv": "tsx scripts/cctv-smoke.ts",
    "test:cctv:live": "esbuild scripts/cctv-live-smoke.ts --bundle --platform=node --format=cjs --external:electron --outfile=.tmp/cctv-live-smoke.cjs && electron .tmp/cctv-live-smoke.cjs",
    "test:cctv:download": "esbuild scripts/cctv-download-smoke.ts --bundle --platform=node --format=cjs --external:electron --external:ffmpeg-static --outfile=.tmp/cctv-download-smoke.cjs && electron .tmp/cctv-download-smoke.cjs",
    "test:deep": "esbuild scripts/deep-smoke.ts --bundle --platform=node --format=cjs --external:electron --outfile=.tmp/deep-smoke.cjs && electron .tmp/deep-smoke.cjs",
    "test:generic": "esbuild scripts/generic-smoke.ts --bundle --platform=node --format=cjs --external:electron --outfile=.tmp/generic-smoke.cjs && electron .tmp/generic-smoke.cjs",
    "test:ui": "tsx scripts/ui-smoke.ts",
    "test:download": "tsx scripts/download-smoke.ts",
    "test:bilibili": "esbuild scripts/bilibili-merge-smoke.ts --bundle --platform=node --format=cjs --external:electron --external:ffmpeg-static --outfile=.tmp/bilibili-merge-smoke.cjs && electron .tmp/bilibili-merge-smoke.cjs",
    "release:github": "node scripts/github-release.mjs",
    "test:storage": "tsx scripts/storage-smoke.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.framekit.desktop",
    "productName": "FrameKit",
    "publish": [
      {
        "provider": "github",
        "owner": "cola4565",
        "repo": "framekit",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "tray.ico"
      },
      {
        "from": "assets/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "assets/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FrameKit-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "shortcutName": "FrameKit"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "FrameKit-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "FrameKit ${version}"
    }
  }
}
